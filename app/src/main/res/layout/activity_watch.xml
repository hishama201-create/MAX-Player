<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.media3.ui.PlayerView
        android:id="@+id/watch_player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:keepScreenOn="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:use_controller="true" />

    <ProgressBar
        android:id="@+id/watch_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintTop_toTopOf="@id/watch_player"
        app:layout_constraintBottom_toBottomOf="@id/watch_player"
        app:layout_constraintStart_toStartOf="@id/watch_player"
        app:layout_constraintEnd_toEndOf="@id/watch_player" />


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/watch_coordinator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/watch_player"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/watch_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/watch_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll">
    <TextView
        android:id="@+id/watch_title"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"


 />

    <TextView
        android:id="@+id/watch_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"


 />

    <TextView
        android:id="@+id/watch_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone"
 />

    <TextView
        android:id="@+id/watch_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone"
 />

    <LinearLayout
        android:id="@+id/watch_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"


>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_download_audio"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/audio"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_music" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_download_video"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:contentDescription="@string/video"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_video" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_favorite"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/watch_favorites"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_watch_fav_off" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_share"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/share"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_watch_share" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_copy_link"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/copy_url"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_watch_copy" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_sleep_timer"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/watch_sleep_timer"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_watch_timer" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_quality"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="55dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/watch_quality"
            android:elevation="0dp"
            android:outlineProvider="none"
            app:icon="@drawable/ic_watch_quality" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/watch_lyrics"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/lyrics"
        app:icon="@drawable/ic_lyrics" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/watch_cc"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:text="@string/subtitles"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/watch_chapters_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:scrollbars="none"
        android:visibility="gone"


>

        <LinearLayout
            android:id="@+id/watch_chapters_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
            </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/watch_chips_scroll"
        android:background="?attr/colorSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none"


>

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/watch_all" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_from_results"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_from_results" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_from_channel"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_from_channel" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_similar"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_similar" />

                <com.google.android.material.chip.Chip
                android:id="@+id/chip_favorites"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_favorites" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_history"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_history" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

        </com.google.android.material.appbar.AppBarLayout>

        <TextView
            android:id="@+id/watch_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/watch_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/watch_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:defaultNavHost="false"
        app:navGraph="@navigation/watch_nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
