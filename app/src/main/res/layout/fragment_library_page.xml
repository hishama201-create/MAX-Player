<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fastScrollEnabled="true"
        app:fastScrollHorizontalThumbDrawable="@drawable/library_fastscroll_thumb"
        app:fastScrollHorizontalTrackDrawable="@drawable/library_fastscroll_track"
        app:fastScrollVerticalThumbDrawable="@drawable/library_fastscroll_thumb"
        app:fastScrollVerticalTrackDrawable="@drawable/library_fastscroll_track"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/library_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/library_placeholder" />
        <Button
            android:id="@+id/library_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/library_grant"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
